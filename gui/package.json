{
  "name": "wes-gui",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "wes's Surface client over the engine protocol",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run view:generate",
    "preview": "vite preview",
    "view:dev": "vite --config vite.view-dev.config.ts",
    "view:build": "vite build --config vite.view-dev.config.ts",
    "view:generate": "node ../tools/view-build.mjs",
    "prebuild": "npm run view:generate",
    "preview:build": "npm run view:generate",
    "predev": "npm run view:generate",
    "preview:dev": "npm run view:generate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^1.1.4",
    "@lezer/highlight": "^1.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.3.5",
    "lossless-json": "4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
}
