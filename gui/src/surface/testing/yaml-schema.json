  "constraints": {
    "environment-identifier": {
      "description": "Environment names follow the core identifier rules.",
      "validation": "semantic"
    },
    "count-range": {
      "description": "Counts are integers from 0 through 2147483647.",
      "validation": "semantic"
    },
    "type-resolution": {
      "description": "Type expressions resolve against the workspace registry and constructor arity.",
      "validation": "semantic"
    },
    "docker-target": {
      "description": "Docker target socket, container and image constraints are checked by the environment parser.",
      "validation": "semantic"
    },
    "environment-resolution": {
      "description": "Inheritance, configuration, ownership and import conflicts are resolved by the engine.",
      "validation": "semantic"
    },
    "spec-source": {
      "description": "Spec file/url exclusivity, location scheme and SHA-256 are checked by the environment parser.",
      "validation": "semantic"
    },
    "environment-binding": {
      "description": "Endpoint requires Text; timeout requires positive Int; references must resolve to compatible slots. Process imports cannot set endpoint.",
      "validation": "semantic"
    },
    "contract-subtype": {
      "description": "Constraints must match the resolved base kind and cannot weaken inherited limits or fields.",
      "validation": "semantic"
    },
    "iterator-output": {
      "description": "Iterator output must resolve to Iter<T>.",
      "validation": "semantic"
    },
    "iterator-input": {
      "description": "Iterator mode must match the resolved input shape; extraction patterns and limits are checked by core.",
      "validation": "semantic"
    },
    "provider-definition": {
      "description": "Version 1; provider and operation/parameter names are bounded identifiers. Bounded strict YAML source and 1–256 distinct operations. Types default to an empty mapping and resolve within this document. Import captures declarations without launching the executable; operations are unsafe and require ordinary execution admission.",
      "validation": "semantic"
    },
    "provider-process": {
      "description": "bin is an explicit executable path; relative paths resolve from the definition directory. Every parameter needs an argv mapping. Process targets use the captured environment execution boundary.",
      "validation": "semantic"
    },
    "provider-session": {
      "description": "Local target only. credentials defaults to []; at most 16 distinct identifier slots (no hyphens), with material supplied through the native environment form. Operations require JSON results, literal argv and success_codes [0]. Versioned bounded duplex frames carry calls, readiness, events, controls and finite outcomes; import never starts a session.",
      "validation": "semantic"
    },
    "provider-operation": {
      "description": "path has 1–16 identifier segments; summary defaults to empty (max 4096 bytes). parameters defaults to [] (max 256 distinct names). argv has fewer than 1024 members; success_codes defaults to [0] (1–256 unsigned 32-bit codes). streaming defaults to false and requires a session backend. Resolved input/output contracts must be materialized.",
      "validation": "semantic"
    },
    "provider-argv": {
      "description": "A Text is one literal argument, never a shell program. Parameter mappings default prefix to [] and encoding to scalar. scalar accepts scalar types except Bytes; spread requires a list of those scalars; flag requires Bool and a nonempty prefix; json accepts materialized values. Optional missing parameters omit their mapping. Arguments/prefixes cannot contain NUL; final size/count budgets still apply.",
      "validation": "semantic"
    },
    "provider-result": {
      "description": "json requires an explicit type. text defaults to Text and bytes to Bytes; overrides must retain that shape. process has the fixed ProcessOutput contract and forbids type. JSON Bytes fields use canonical base64 only where the captured contract declares Bytes.",
      "validation": "semantic"
    },
    "provider-control": {
      "description": "Requires streaming on a session backend. input and output resolve to materialized contracts. output_policy defaults to public; native environment and input restrictions still apply. Controls belong to one admitted live connection; uncertain external outcomes must not be automatically replayed.",
      "validation": "semantic"
    },
    "provider-read-access": {
      "description": "Opt-in managed-environment read domain. scope contains 1–16 distinct required Text parameters present on every operation. revalidate names one finite Bool operation whose only parameters are that scope. Only explicit native revalidation returning true opens captured reads. Expiry/revoke/material or binding changes close reads; retained bytes, re-enabling and new grants cannot revive old work. Import never probes.",
      "validation": "semantic"
    }
  }
}
