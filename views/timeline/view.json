{
  "name": "Timeline",
  "id": "timeline",
  "summary": "Explore finite time-series and events in UTC.",
  "renderer": "View.tsx",
  "input": "Timeline",
  "outputs": {
    "cursor": {
      "type": "Option<Instant>",
      "mode": "state",
      "shared": false
    },
    "selection": {
      "type": "Option<Interval>",
      "mode": "state",
      "shared": true
    },
    "selectedItem": {
      "type": "Option<TimelineItem>",
      "mode": "state",
      "shared": true
    },
    "picked": {
      "type": "TimelineItem",
      "mode": "event",
      "shared": true
    }
  },
  "interaction": {
    "protocol": "TimeNavigation",
    "state": "TimeState",
    "event": "TimeEvent",
    "sharedFields": [
      "viewport",
      "selection",
      "selectedItem"
    ]
  },
  "layout": {
    "preview": {
      "min": {
        "columns": 32,
        "rows": 4
      },
      "preferred": {
        "columns": 80,
        "rows": 7
      },
      "max": {
        "columns": 320,
        "rows": 8
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    },
    "expanded": {
      "min": {
        "columns": 40,
        "rows": 10
      },
      "preferred": {
        "columns": 96,
        "rows": 18
      },
      "max": {
        "columns": 320,
        "rows": 28
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    },
    "window": {
      "min": {
        "columns": 48,
        "rows": 16
      },
      "preferred": {
        "columns": 120,
        "rows": 32
      },
      "max": {
        "columns": 512,
        "rows": 120
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    }
  }
}
