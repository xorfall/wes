{
  "name": "TaskBoard",
  "id": "task-board",
  "summary": "Choose a task state from a bounded task summary.",
  "renderer": "View.tsx",
  "input": "TaskBoard",
  "outputs": {
    "selected": {
      "type": "Text",
      "mode": "state",
      "shared": true
    }
  },
  "interaction": {
    "protocol": "TaskSelection",
    "state": "TaskState",
    "event": "TaskEvent",
    "sharedFields": [
      "selected"
    ]
  },
  "layout": {
    "preview": {
      "min": {
        "columns": 24,
        "rows": 4
      },
      "preferred": {
        "columns": 80,
        "rows": 6
      },
      "max": {
        "columns": 160,
        "rows": 8
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    },
    "expanded": {
      "min": {
        "columns": 24,
        "rows": 4
      },
      "preferred": {
        "columns": 80,
        "rows": 14
      },
      "max": {
        "columns": 160,
        "rows": 40
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    },
    "window": {
      "min": {
        "columns": 24,
        "rows": 4
      },
      "preferred": {
        "columns": 80,
        "rows": 24
      },
      "max": {
        "columns": 160,
        "rows": 80
      },
      "placement": {
        "width": "fill",
        "align": "start"
      }
    }
  }
}
